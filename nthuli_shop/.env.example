# M-Pesa Configuration - .env.example
# Copy this file to .env and fill in your actual values

# M-Pesa Sandbox Credentials (from Safaricom Daraja Portal)
# Get these from: https://developer.safaricom.co.ke

# OAuth credentials
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET_HERE

# Business configuration
MPESA_PARTY_B=174379  # Business shortcode (provided by Safaricom)
MPESA_PARTY_A=your_phone_number_here  # Initiator phone number
MPESA_PASS_KEY=your_passkey_here  # Passkey (provided by Safaricom)

# API URLs (Sandbox - for production use https://api.safaricom.co.ke endpoints)
MPESA_STK_PUSH_URL=https://api.sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_ACCESS_TOKEN_URL=https://api.sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials

# Callback configuration - this should be your public URL
MPESA_CALLBACK_URL=http://localhost:8080/api/payments/mpesa/callback
# For production:
# MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback

# Test phone number (for sandbox testing)
# Use: 254708374149 with PIN: 123456
