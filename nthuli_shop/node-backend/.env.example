NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nthuli_shop
DB_USER=root
DB_PASSWORD=root

# JWT
JWT_SECRET=your_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_this_in_production
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# CORS
CORS_ORIGIN=http://localhost:5173
