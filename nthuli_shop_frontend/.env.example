# Backend API Configuration
# Use these environment variables to configure the application for different environments

# API Base URL (includes /api path)
# Development: http://localhost:8080/api
# Production: Your production API URL
VITE_API_BASE_URL=http://localhost:8080/api

# Image Base URL (for loading product images)
# Development: http://localhost:8080
# Production: Your production image server URL or CDN
VITE_API_IMAGE_BASE_URL=http://localhost:8080

# Paystack Public Key (use test key in development)
# Example: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
